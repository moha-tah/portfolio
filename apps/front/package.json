{
  "name": "front",
  "author": "Mohamed Tahiri",
  "description": "Next.js 15 frontend for my portfolio",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 8080",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript ../back/swagger.json -o src/lib/api/schema.d.ts",
    "api:watch": "chokidar '../back/swagger.json' -c 'pnpm api:generate' --initial",
    "sanity:seed": "tsx scripts/seed-sanity.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@next/eslint-plugin-next": "^15.4.6",
    "@portabletext/react": "^4",
    "@sanity/image-url": "^1",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.85.5",
    "chokidar-cli": "^3.0.0",
    "lenis": "1.3.11",
    "next": "15.4.10",
    "next-sanity": "11.6.13",
    "next-turnstile": "^1.0.5",
    "openapi-fetch": "^0.14.0",
    "openapi-typescript": "^7.9.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.62.0",
    "sanity": "4.22.1",
    "server-only": "^0.0.1",
    "styled-components": "^6.1.15",
    "sugar-high": "0.9.3",
    "three": "0.180.0",
    "utils": "workspace:*",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.180.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-turbo": "^2.5.6",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.5.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "tsx": "4.20.6",
    "typescript": "^5"
  }
}
