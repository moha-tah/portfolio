{
  "extends": [
    "//"
  ],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL_URL",
    "VERCEL_ENV",
    "NEXT_PUBLIC_FRONT_URL",
    "NEXT_PUBLIC_BACK_URL",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
    "NEXT_PUBLIC_SANITY_PROJECT_ID",
    "NEXT_PUBLIC_SANITY_DATASET"
  ],
  "tasks": {
    "build": {
      "env": [
        "NODE_ENV",
        "VERCEL_ENV",
        "VERCEL_URL",
        "NEXT_PUBLIC_FRONT_URL",
        "NEXT_PUBLIC_BACK_URL",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
        "NEXT_PUBLIC_SANITY_PROJECT_ID",
        "NEXT_PUBLIC_SANITY_DATASET"
      ],
      "dependsOn": [
        "^build",
        "api:generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "with": [
        "api:watch",
        "utils#dev"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [
        "next-env.d.ts"
      ]
    },
    "lint:fix": {
      "outputs": [
        "next-env.d.ts"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "api:generate"
      ]
    },
    "api:generate": {
      "dependsOn": [
        "back#swagger:generate"
      ],
      "outputs": [
        "src/lib/api/schema.d.ts"
      ]
    },
    "api:watch": {
      "cache": false,
      "persistent": true
    },
    "sanity:seed": {
      "env": [
        "SANITY_API_WRITE_TOKEN"
      ],
      "cache": false
    }
  }
}
